index 00000000..3e902358
--- /dev/null
+++ b/dm/host/friends_link.c
@@ -0,0 +1,308 @@
+#include "friends_link.h"
+#include <CommonCrypto/CommonCrypto.h>
+#include <CommonCrypto/CommonKeyDerivation.h>
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+// Wire: magic 4, type 1, zero 3, sender nonce 8, receiver nonce 8, counter 8, payload, tag 16 (HMAC-SHA256, cut to 16, over all before it).
+// A nonce is random per run, so a packet recorded in one run means nothing in another; the counter window refuses repeats within a run;
+// a nonce once replaced is never taken again; a packet bearing this Mac's own nonce as sender is a reflection.
+enum { T_HELLO = 1, T_WELCOME, T_PING, T_SCAN, T_ROOM, T_JOIN, T_REFUSED, T_SYNC, T_LEAVE, T_KICK, T_DATA, T_MAX };
+enum { HDR = 32, TAG = 16, RETIRED = 32, LOST_MS = 6000, JOIN_MS = 4000, SCAN_MS = 450 };
+static const uint8_t MAGIC[4] = {'D', 'S', 'F', '1'};
+typedef struct {
+    struct sockaddr_in addr; uint64_t nonce, high, window, retired[RETIRED]; unsigned nretired; int up; uint64_t seen, hello_at, welcome_at;
+    int node; fl_network room; uint64_t room_at;
+} peer;
+struct friends_link {
+    pthread_mutex_t m; pthread_t th; int fd, stop, threaded; fl_setup set; fl_hooks h; uint64_t nonce, counter; uint8_t mac[6];
+    peer p[FL_PEERS]; int state, reason, host; fl_network net; fl_update upd[8]; uint8_t pass[32]; uint64_t sync_at;
+    int joining, join_peer, refused; fl_stats st; int dirty;
+};
+typedef struct { uint8_t session[16], pass[32]; fl_user user; int16_t version; uint8_t r[6]; } join_msg;
+typedef struct { uint32_t src, dst; uint16_t sport, dport; } data_head;
+static uint64_t ms(void) { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1000000; }
+static void hmac(const uint8_t key[32], const void *d, size_t n, uint8_t out[32]) { CCHmac(kCCHmacAlgSHA256, key, 32, d, n, out); }
+static int tag_ok(const uint8_t *a, const uint8_t *b) { uint8_t x = 0; for (int i = 0; i < TAG; i++) x |= a[i] ^ b[i]; return !x; }
+
+int fl_derive(const char *code, uint8_t key[32]) {
+    static const uint8_t salt[] = "Dockside friends link v1";
+    return CCKeyDerivationPBKDF(kCCPBKDF2, code, strlen(code), salt, sizeof salt - 1, kCCPRFHmacAlgSHA256, 300000, key, 32) == kCCSuccess ? 0 : -1;
+}
+int fl_private_ip(uint32_t ip, int loop) {   // home networks and the range Tailscale uses; never a public address
+    return ip >> 24 == 10 || ip >> 20 == 0xAC1 || ip >> 16 == 0xC0A8 || ip >> 22 == 0x191 || (loop && ip >> 24 == 127);
+}
+static int parse_addr(char *s, uint16_t port, int loop, struct sockaddr_in *o) {
+    char *c = strchr(s, ':'); long p = port; if (c) { *c = 0; char *e; p = strtol(c + 1, &e, 10); if (*e || c[1] == 0) return -1; }
+    memset(o, 0, sizeof *o); o->sin_len = sizeof *o; o->sin_family = AF_INET;
+    if (p < 1024 || p > 65535 || inet_pton(AF_INET, s, &o->sin_addr) != 1 || !fl_private_ip(ntohl(o->sin_addr.s_addr), loop)) return -1;
+    o->sin_port = htons((uint16_t)p); return 0;
+}
+int fl_load(const char *path, int loop, fl_setup *o, char *why, size_t wl) {
+#define NO(...) do { snprintf(why, wl, __VA_ARGS__); if (f) fclose(f); memset(o, 0, sizeof *o); return -1; } while (0)
+    FILE *f = NULL; memset(o, 0, sizeof *o); o->port = FL_PORT; struct stat s;
+    int fd = open(path, O_RDONLY | O_NOFOLLOW); if (fd < 0) NO("no friends file");
+    if (fstat(fd, &s) || !S_ISREG(s.st_mode) || s.st_uid != getuid() || s.st_size > 4096) { close(fd); NO("the friends file is not an ordinary file of yours"); }
+    if (s.st_mode & 077) { close(fd); NO("the friends file can be read by others (chmod 600 it)"); }
+    if (!(f = fdopen(fd, "r"))) { close(fd); NO("cannot read the friends file"); }
+    char line[256], code[128] = "", raw[FL_PEERS][64]; int n = 0, have_port = 0;
+    while (fgets(line, sizeof line, f)) {
+        line[strcspn(line, "\r\n")] = 0; if (!line[0] || line[0] == '#') continue;
+        char *eq = strchr(line, '='); if (!eq) NO("a line has no =");
+        *eq++ = 0; if (!strcmp(line, "code")) { if (strlen(eq) >= sizeof code) NO("the friend code is too long"); strcpy(code, eq); }
+        else if (!strcmp(line, "friend")) { if (n == FL_PEERS) NO("too many friends (7)"); if (strlen(eq) >= sizeof raw[0]) NO("a friend's address is too long"); strcpy(raw[n++], eq); }
+        else if (!strcmp(line, "port")) { char *e; long p = strtol(eq, &e, 10); if (*e || p < 1024 || p > 65535) NO("the port is not 1024 to 65535"); o->port = (uint16_t)p; have_port = 1; }
+        else if (!strcmp(line, "mine")) { if (inet_pton(AF_INET, eq, &o->bind) != 1 || !fl_private_ip(ntohl(o->bind.s_addr), loop)) NO("mine is not a private address"); }
+        else NO("unknown setting: %s", line);
+    }
+    (void)have_port;
+    if (strlen(code) < 16) NO("the friend code needs at least 16 characters");
+    if (!n) NO("no friends listed");
+    if (!o->bind.s_addr) NO("mine= (this Mac's own private address) is missing");
+    for (int i = 0; i < n; i++) if (parse_addr(raw[i], FL_PORT, loop, &o->peers[i])) NO("a friend's address is not a private IPv4 address");
+    for (int i = 0; i < n; i++) for (int j = 0; j < i; j++) if (o->peers[i].sin_addr.s_addr == o->peers[j].sin_addr.s_addr && o->peers[i].sin_port == o->peers[j].sin_port) NO("the same friend is listed twice");
+    o->npeers = n; if (fl_derive(code, o->key)) NO("cannot make the key");
+    memset(code, 0, sizeof code); fclose(f); return 0;
+#undef NO
+}
+
+// ---- sending (with the lock held) ----
+static void put(friends_link *f, peer *p, int type, const void *d, size_t n) {
+    if (n > FL_PAYLOAD || f->fd < 0) return;
+    uint8_t b[HDR + FL_PAYLOAD + TAG] = {0}, t[32]; uint64_t to = type == T_HELLO ? 0 : p->nonce, c = ++f->counter;
+    memcpy(b, MAGIC, 4); b[4] = (uint8_t)type; memcpy(b + 8, &f->nonce, 8); memcpy(b + 16, &to, 8); memcpy(b + 24, &c, 8); if (n) memcpy(b + HDR, d, n);
+    hmac(f->set.key, b, HDR + n, t); memcpy(b + HDR + n, t, TAG);
+    if (sendto(f->fd, b, HDR + n + TAG, 0, (struct sockaddr *)&p->addr, sizeof p->addr) > 0) f->st.tx++;
+}
+static void changed(friends_link *f) { f->dirty = 1; }
+static void sync_room(friends_link *f) { for (int i = 0; i < f->set.npeers; i++) if (f->p[i].node > 0) put(f, &f->p[i], T_SYNC, &f->net, sizeof f->net); f->sync_at = ms(); }
+static void note(friends_link *f, int node, int change) { f->upd[node].change |= (uint8_t)change; }
+static void drop_node(friends_link *f, peer *p) {   // host: a member is gone
+    if (f->state != FL_CREATED || p->node <= 0) { p->node = 0; return; }
+    memset(&f->net.nodes[p->node], 0, sizeof(fl_node)); f->net.nodes[p->node].id = (int8_t)p->node; if (f->net.node_count) f->net.node_count--;
+    note(f, p->node, 2); p->node = 0; sync_room(f); changed(f);
+}
+static void lose_host(friends_link *f, int reason) { if (f->state == FL_CONNECTED) { f->state = FL_STATION; f->reason = reason; f->host = -1; memset(&f->net, 0, sizeof f->net); changed(f); } f->joining = 0; }
+static void peer_down(friends_link *f, int i) {
+    peer *p = &f->p[i]; if (!p->up) return;
+    p->up = 0; p->room_at = 0; p->retired[p->nretired++ % RETIRED] = p->nonce; p->nonce = 0; drop_node(f, p);
+    if (f->host == i) lose_host(f, 6);
+}
+static int net_ok(const fl_network *n) {   // what a friend sends is checked too
+    if (n->max_nodes < 1 || n->max_nodes > 8 || n->node_count < 1 || n->node_count > n->max_nodes || n->advertise_size > 384 || n->common.ssid.len > 32 || n->accept_policy > 3) return 0;
+    int c = 0;
+    for (int i = 0; i < 8; i++) { const fl_node *d = &n->nodes[i]; if (d->connected > 1) return 0; if (!d->connected) continue; c++;
+        if (i >= n->max_nodes || d->id != i || d->ip != FL_NET + 1 + (uint32_t)i || !memchr(d->name, 0, sizeof d->name)) return 0; }
+    return c == n->node_count && n->nodes[0].connected;
+}
+
+// ---- receiving (with the lock held) ----
+typedef struct { int have; data_head h; size_t n; uint8_t d[FL_PAYLOAD]; } delivery;
+static int member_of(friends_link *f, uint32_t ip) { for (int i = 0; i < 8; i++) if (f->net.nodes[i].connected && f->net.nodes[i].ip == ip) return i; return -1; }
+int fl_is_broadcast(uint32_t ip) { return ip == FL_NET + 255 || ip == 0xFFFFFFFFu; }
+int fl_is_virtual(uint32_t ip) { return (ip & FL_MASK) == FL_NET || ip == 0xFFFFFFFFu; }
+static uint32_t own_ip(friends_link *f) {
+    if (f->state == FL_CREATED) return FL_NET + 1;
+    if (f->state == FL_CONNECTED) for (int i = 1; i < 8; i++) if (f->net.nodes[i].connected && !memcmp(f->net.nodes[i].mac, f->mac, 6)) return f->net.nodes[i].ip;
+    return 0;
+}
+static void on_join(friends_link *f, peer *p, const join_msg *j) {
+    uint8_t why = 0; fl_node *slot = NULL; int at = 0;
+    if (f->state != FL_CREATED || memcmp(j->session, f->net.id.session, 16)) why = 1;
+    else if (p->node > 0) { put(f, p, T_SYNC, &f->net, sizeof f->net); return; }   // asked again
+    else if (!tag_ok(j->pass, f->pass) || !tag_ok(j->pass + 16, f->pass + 16)) why = 2;
+    else if (f->net.accept_policy == 1 || f->net.accept_policy == 3) why = 3;   // closed, or a list this link has no use for
+    else if (j->version != f->net.nodes[0].version) why = 4;
+    else if (!memchr(j->user.name, 0, sizeof j->user.name)) why = 5;
+    else { for (int i = 1; i < f->net.max_nodes; i++) if (!f->net.nodes[i].connected) { slot = &f->net.nodes[i]; at = i; break; } if (!slot) why = 6; }
+    if (why) { f->st.refused++; put(f, p, T_REFUSED, &why, 1); return; }
+    memset(slot, 0, sizeof *slot); slot->ip = FL_NET + 1 + (uint32_t)at; slot->mac[0] = 2; memcpy(slot->mac + 1, &p->nonce, 5); slot->id = (int8_t)at; slot->connected = 1;
+    memcpy(slot->name, j->user.name, sizeof slot->name); slot->version = j->version; p->node = at; f->net.node_count++; note(f, at, 1); sync_room(f); changed(f);
+}
+static void on_sync(friends_link *f, int i, const fl_network *n) {
+    if (!net_ok(n)) { f->st.bad_packet++; return; }
+    int here = 0; for (int k = 1; k < 8; k++) here |= n->nodes[k].connected && !memcmp(n->nodes[k].mac, f->mac, 6);
+    if (f->joining && f->join_peer == i && here) { f->net = *n; f->state = FL_CONNECTED; f->host = i; f->reason = 0; f->joining = 0; memset(f->upd, 0, sizeof f->upd); changed(f); return; }
+    if (f->state != FL_CONNECTED || f->host != i) return;
+    if (!here || memcmp(n->id.session, f->net.id.session, 16)) { lose_host(f, 5); return; }
+    if (memcmp(n, &f->net, sizeof *n)) { for (int k = 0; k < 8; k++) if (n->nodes[k].connected != f->net.nodes[k].connected) note(f, k, n->nodes[k].connected ? 1 : 2); f->net = *n; changed(f); }
+}
+static void on_data(friends_link *f, int i, const uint8_t *d, size_t n, delivery *out) {
+    if (n < sizeof(data_head)) { f->st.bad_packet++; return; }
+    data_head h; memcpy(&h, d, sizeof h); int bc = fl_is_broadcast(h.dst), from = member_of(f, h.src); uint32_t me = own_ip(f);
+    if (!me || from < 0 || h.src == me || !fl_is_virtual(h.dst) || !h.sport || !h.dport) { f->st.refused++; return; }
+    if (f->state == FL_CREATED) {
+        if (f->p[i].node != from) { f->st.refused++; return; }   // only as itself
+        if (h.dst != me) for (int k = 0; k < f->set.npeers; k++) if (k != i && f->p[k].node > 0 && (bc || f->net.nodes[f->p[k].node].ip == h.dst)) put(f, &f->p[k], T_DATA, d, n);
+    } else if (f->host != i) { f->st.refused++; return; }
+    if (bc || h.dst == me) { out->have = 1; out->h = h; out->n = n - sizeof h; memcpy(out->d, d + sizeof h, out->n); }
+}
+static void receive(friends_link *f, const uint8_t *b, size_t n, const struct sockaddr_in *from, delivery *out) {
+    int i = 0; while (i < f->set.npeers && (f->p[i].addr.sin_addr.s_addr != from->sin_addr.s_addr || f->p[i].addr.sin_port != from->sin_port)) i++;
+    if (i == f->set.npeers) { f->st.bad_source++; return; }
+    if (n < HDR + TAG || n > HDR + FL_PAYLOAD + TAG || memcmp(b, MAGIC, 4) || b[5] || b[6] || b[7] || !b[4] || b[4] >= T_MAX) { f->st.bad_packet++; return; }
+    uint8_t t[32]; hmac(f->set.key, b, n - TAG, t); if (!tag_ok(t, b + n - TAG)) { f->st.bad_tag++; return; }
+    peer *p = &f->p[i]; uint64_t s, r, c; memcpy(&s, b + 8, 8); memcpy(&r, b + 16, 8); memcpy(&c, b + 24, 8); uint64_t now = ms();
+    const uint8_t *d = b + HDR; size_t dn = n - HDR - TAG; int type = b[4];
+    if (!s || s == f->nonce) { f->st.replay++; return; }
+    if (type == T_HELLO) {   // can be a recording: answer, change nothing
+        if (r || dn) { f->st.bad_packet++; return; }
+        if (now - p->welcome_at < 200) return;
+        p->welcome_at = now; peer ans = {.addr = p->addr, .nonce = s}; put(f, &ans, T_WELCOME, NULL, 0); return;
+    }
+    if (r != f->nonce) { f->st.replay++; return; }
+    if (s != p->nonce || !p->up) {
+        for (unsigned k = 0; k < RETIRED && k < p->nretired; k++) if (p->retired[k] == s) { f->st.replay++; return; }
+        if (type != T_WELCOME && type != T_PING) return;
+        peer_down(f, i); p->nonce = s; p->high = c; p->window = 1; p->up = 1; p->seen = now; f->st.rx++; put(f, p, T_PING, NULL, 0); return;
+    }
+    if (c > p->high) { uint64_t by = c - p->high; p->window = by >= 64 ? 1 : p->window << by | 1; p->high = c; }
+    else { uint64_t by = p->high - c; if (by >= 64 || p->window >> by & 1) { f->st.replay++; return; } p->window |= 1ull << by; }
+    p->seen = now; f->st.rx++;
+    switch (type) {
+        case T_SCAN: if (f->state == FL_CREATED) put(f, p, T_ROOM, &f->net, sizeof f->net); break;
+        case T_ROOM: if (dn == sizeof(fl_network)) { fl_network x; memcpy(&x, d, sizeof x); if (net_ok(&x)) { p->room = x; p->room_at = now; } else f->st.bad_packet++; } else f->st.bad_packet++; break;
+        case T_JOIN: if (dn == sizeof(join_msg)) { join_msg j; memcpy(&j, d, sizeof j); on_join(f, p, &j); } else f->st.bad_packet++; break;
+        case T_REFUSED: if (f->joining && f->join_peer == i) f->refused = 1; break;
+        case T_SYNC: if (dn == sizeof(fl_network)) { fl_network x; memcpy(&x, d, sizeof x); on_sync(f, i, &x); } else f->st.bad_packet++; break;
+        case T_LEAVE: drop_node(f, p); break;
+        case T_KICK: if (f->host == i) lose_host(f, dn == 1 && d[0] == 3 ? 3 : 5); break;
+        case T_DATA: on_data(f, i, d, dn, out); break;
+        default: break;
+    }
+}
+static void tick(friends_link *f) {
+    uint64_t now = ms();
+    for (int i = 0; i < f->set.npeers; i++) { peer *p = &f->p[i];
+        if (p->up && now - p->seen > LOST_MS) peer_down(f, i);
+        if (now - p->hello_at >= 1000) { p->hello_at = now; put(f, p, p->up ? T_PING : T_HELLO, NULL, 0); } }
+    if (f->state == FL_CREATED && now - f->sync_at >= 500) sync_room(f);
+}
+static void *worker(void *a) {
+    friends_link *f = a; pthread_setname_np("friends link"); delivery *out = malloc(sizeof *out); uint8_t *b = malloc(65536);
+    while (out && b && !__atomic_load_n(&f->stop, __ATOMIC_ACQUIRE)) {
+        struct pollfd pf = {f->fd, POLLIN, 0}; int r = poll(&pf, 1, 50);
+        for (int burst = 0; burst < 256; burst++) {
+            struct sockaddr_in from; socklen_t fl = sizeof from; ssize_t n = r > 0 ? recvfrom(f->fd, b, 65536, MSG_DONTWAIT, (struct sockaddr *)&from, &fl) : -1;
+            out->have = 0; pthread_mutex_lock(&f->m); if (n >= 0) receive(f, b, (size_t)n, &from, out);
+            if (n < 0) tick(f);
+            int ev = f->dirty; f->dirty = 0; pthread_mutex_unlock(&f->m);
+            if (out->have && f->h.data) f->h.data(f->h.opaque, out->h.src, out->h.sport, out->h.dst, out->h.dport, out->d, out->n);
+            if (ev && f->h.event) f->h.event(f->h.opaque);
+            if (n < 0) break;
+        }
+        pthread_mutex_lock(&f->m); tick(f); pthread_mutex_unlock(&f->m);
+    }
+    free(out); free(b); return NULL;
+}
+
+// ---- the game's side ----
+#define LOCK pthread_mutex_lock(&f->m)
+#define UNLOCK(x) do { uint32_t r_ = (x); int ev_ = f->dirty; f->dirty = 0; pthread_mutex_unlock(&f->m); if (ev_ && f->h.event) f->h.event(f->h.opaque); return r_; } while (0)
+friends_link *fl_start(const fl_setup *s, const fl_hooks *h) {
+    friends_link *f = calloc(1, sizeof *f); if (!f) return NULL;
+    f->set = *s; f->h = *h; f->host = -1; f->state = FL_INIT; pthread_mutex_init(&f->m, NULL);
+    do arc4random_buf(&f->nonce, 8); while (!f->nonce); f->mac[0] = 2; memcpy(f->mac + 1, &f->nonce, 5);
+    for (int i = 0; i < s->npeers; i++) f->p[i].addr = s->peers[i];
+    struct sockaddr_in a = {.sin_len = sizeof a, .sin_family = AF_INET, .sin_port = htons(s->port), .sin_addr = s->bind};   // never all adapters
+    f->fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (f->fd < 0 || !s->bind.s_addr || bind(f->fd, (struct sockaddr *)&a, sizeof a) || pthread_create(&f->th, NULL, worker, f)) { if (f->fd >= 0) close(f->fd); free(f); return NULL; }
+    fcntl(f->fd, F_SETFD, FD_CLOEXEC); f->threaded = 1; return f;
+}
+void fl_stop(friends_link *f) {
+    if (!f) return;
+    fl_leave(f, 0); fl_leave(f, 1); __atomic_store_n(&f->stop, 1, __ATOMIC_RELEASE); pthread_join(f->th, NULL); close(f->fd);
+    memset(&f->set, 0, sizeof f->set); pthread_mutex_destroy(&f->m); free(f);
+}
+int fl_state(friends_link *f) { if (!f) return 0; LOCK; int s = f->state; pthread_mutex_unlock(&f->m); return s; }
+int fl_reason(friends_link *f) { if (!f) return 0; LOCK; int s = f->reason; pthread_mutex_unlock(&f->m); return s; }
+uint32_t fl_open(friends_link *f, int ap) { if (!f) return FL_E_DISABLED; LOCK; if (f->state != FL_INIT) UNLOCK(FL_E_STATE); f->state = ap ? FL_AP : FL_STATION; f->reason = 0; changed(f); UNLOCK(0); }
+uint32_t fl_leave(friends_link *f, int host) {
+    if (!f) return FL_E_DISABLED; LOCK;
+    if (host) { if (f->state != FL_CREATED) UNLOCK(FL_E_STATE); uint8_t why = 3; for (int i = 0; i < f->set.npeers; i++) { if (f->p[i].node > 0) put(f, &f->p[i], T_KICK, &why, 1); f->p[i].node = 0; } f->state = FL_AP; }
+    else { if (f->state != FL_CONNECTED) UNLOCK(FL_E_STATE); if (f->host >= 0) put(f, &f->p[f->host], T_LEAVE, NULL, 0); f->state = FL_STATION; f->host = -1; f->reason = 1; }
+    memset(&f->net, 0, sizeof f->net); changed(f); UNLOCK(0);
+}
+uint32_t fl_close(friends_link *f, int ap) {
+    if (!f) return FL_E_DISABLED; fl_leave(f, ap); LOCK; if (f->state != (ap ? FL_AP : FL_STATION)) UNLOCK(FL_E_STATE); f->state = FL_INIT; changed(f); UNLOCK(0);
+}
+static void pass_hash(const fl_security *s, const uint8_t session[16], uint8_t out[32]) {
+    uint8_t b[16 + 2 + 64] = {0}; memcpy(b, session, 16); size_t n = s->size > 64 ? 64 : s->size; b[16] = (uint8_t)n; memcpy(b + 18, s->pass, n); CC_SHA256(b, sizeof b, out);
+}
+uint32_t fl_create(friends_link *f, const fl_config *c, const fl_security *s, const fl_user *u, const fl_secparam *sp) {
+    if (!f) return FL_E_DISABLED; if (!c || !s || !u || s->size > 64 || c->max_nodes < 1 || c->max_nodes > 8 || !memchr(u->name, 0, sizeof u->name)) return FL_E_INVALID;
+    LOCK; if (f->state != FL_AP) UNLOCK(FL_E_STATE);
+    fl_network *n = &f->net; memset(n, 0, sizeof *n); n->id.intent = c->intent;
+    if (sp) { memcpy(n->id.session, sp->session, 16); memcpy(n->security, sp->server_random, 16); } else { arc4random_buf(n->id.session, 16); arc4random_buf(n->security, 16); }
+    memcpy(n->common.mac, f->mac, 6); n->common.ssid.len = 32; for (int i = 0; i < 16; i++) snprintf(n->common.ssid.text + 2 * i, 3, "%02x", n->id.session[i]);
+    n->common.channel = c->channel ? c->channel : 6; n->common.link = 3; n->common.type = 2; n->security_mode = s->mode; n->max_nodes = c->max_nodes; n->node_count = 1; n->version = 3;
+    for (int i = 0; i < 8; i++) n->nodes[i].id = (int8_t)i;
+    n->nodes[0].ip = FL_NET + 1; memcpy(n->nodes[0].mac, f->mac, 6); n->nodes[0].connected = 1; memcpy(n->nodes[0].name, u->name, 33); n->nodes[0].version = c->version;
+    pass_hash(s, n->id.session, f->pass); memset(f->upd, 0, sizeof f->upd); f->state = FL_CREATED; f->reason = 0; changed(f); UNLOCK(0);
+}
+static int matches(const fl_network *n, const fl_filter *q) {
+    if (!q) return 1; uint32_t k = q->flags;
+    if (k & 1 && n->id.intent.local_id != q->id.intent.local_id) return 0;
+    if (k & 2 && memcmp(n->id.session, q->id.session, 16)) return 0;
+    if (k & 4 && !(n->common.type & q->type)) return 0;
+    if (k & 8 && memcmp(n->common.mac, q->mac, 6)) return 0;
+    if (k & 16 && (q->ssid.len > 32 || n->common.ssid.len != q->ssid.len || memcmp(n->common.ssid.text, q->ssid.text, q->ssid.len))) return 0;
+    return !(k & 32) || n->id.intent.scene == q->id.intent.scene;
+}
+uint32_t fl_scan(friends_link *f, fl_network *o, int *count, int max, const fl_filter *q) {
+    if (!f) return FL_E_DISABLED; if (!count || max < 0 || (max && !o)) return FL_E_INVALID;
+    *count = 0; LOCK; if (f->state < FL_AP) UNLOCK(FL_E_STATE);
+    for (int i = 0; i < f->set.npeers; i++) { f->p[i].room_at = 0; if (f->p[i].up) put(f, &f->p[i], T_SCAN, NULL, 0); } pthread_mutex_unlock(&f->m);
+    for (int t = 0; t < SCAN_MS; t += 15) f->h.sleep_ms(15);
+    LOCK; for (int i = 0; i < f->set.npeers && *count < max; i++) if (f->p[i].room_at && matches(&f->p[i].room, q)) o[(*count)++] = f->p[i].room; UNLOCK(0);
+}
+uint32_t fl_connect_session(friends_link *f, const uint8_t session[16], const fl_security *s, const fl_user *u, int version) {
+    if (!f) return FL_E_DISABLED; if (!session || !s || !u || s->size > 64 || !memchr(u->name, 0, sizeof u->name)) return FL_E_INVALID;
+    LOCK; if (f->state != FL_STATION) UNLOCK(FL_E_STATE);
+    int at = -1; for (int i = 0; i < f->set.npeers; i++) if (f->p[i].up && f->p[i].room_at && !memcmp(f->p[i].room.id.session, session, 16)) at = i;
+    if (at < 0) UNLOCK(FL_E_NOTFOUND);
+    join_msg j = {.user = *u, .version = (int16_t)version}; memcpy(j.session, session, 16); pass_hash(s, session, j.pass);
+    f->joining = 1; f->join_peer = at; f->refused = 0; pthread_mutex_unlock(&f->m);
+    uint32_t r = FL_E_TIMEOUT;
+    for (int t = 0; t < JOIN_MS; t += 15) {
+        LOCK; if (f->state == FL_CONNECTED) r = 0; else if (f->refused) r = FL_E_REJECTED; else if (!f->joining) r = FL_E_CONNECT; else if (t % 210 == 0) put(f, &f->p[at], T_JOIN, &j, sizeof j);
+        pthread_mutex_unlock(&f->m); if (r != FL_E_TIMEOUT) break; f->h.sleep_ms(15);
+    }
+    LOCK; f->joining = 0; if (r == FL_E_TIMEOUT) put(f, &f->p[at], T_LEAVE, NULL, 0); UNLOCK(r);
+}
+uint32_t fl_connect(friends_link *f, const fl_network *n, const fl_security *s, const fl_user *u, int v) { return n ? fl_connect_session(f, n->id.session, s, u, v) : FL_E_INVALID; }
+uint32_t fl_info(friends_link *f, fl_network *o, fl_update *up, int n) {
+    if (!f) return FL_E_DISABLED; if (!o || n < 0 || n > 8 || (n && !up)) return FL_E_INVALID; LOCK;
+    if (f->state != FL_CREATED && f->state != FL_CONNECTED) UNLOCK(FL_E_STATE);
+    *o = f->net; if (up) { memcpy(up, f->upd, sizeof *up * (size_t)n); memset(f->upd, 0, sizeof *up * (size_t)n); } UNLOCK(0);
+}
+uint32_t fl_advertise(friends_link *f, const void *d, size_t n) {
+    if (!f) return FL_E_DISABLED; if (n > 384 || (n && !d)) return FL_E_INVALID; LOCK; if (f->state != FL_AP && f->state != FL_CREATED) UNLOCK(FL_E_STATE);
+    memset(f->net.advertise, 0, 384); if (n) memcpy(f->net.advertise, d, n); f->net.advertise_size = (uint16_t)n; if (f->state == FL_CREATED) { sync_room(f); changed(f); } UNLOCK(0);
+}
+uint32_t fl_policy(friends_link *f, int p) { if (!f) return FL_E_DISABLED; if (p < 0 || p > 3) return FL_E_INVALID; LOCK; if (f->state != FL_AP && f->state != FL_CREATED) UNLOCK(FL_E_STATE); f->net.accept_policy = (uint8_t)p; UNLOCK(0); }
+uint32_t fl_kick(friends_link *f, uint32_t ip) {
+    if (!f) return FL_E_DISABLED; LOCK; if (f->state != FL_CREATED) UNLOCK(FL_E_STATE); uint8_t why = 5;
+    for (int i = 0; i < f->set.npeers; i++) if (f->p[i].node > 0 && f->net.nodes[f->p[i].node].ip == ip) { put(f, &f->p[i], T_KICK, &why, 1); drop_node(f, &f->p[i]); UNLOCK(0); } UNLOCK(FL_E_NOTFOUND);
+}
+uint32_t fl_address(friends_link *f) { if (!f) return 0; LOCK; uint32_t a = own_ip(f); pthread_mutex_unlock(&f->m); return a; }
+int fl_send(friends_link *f, uint16_t sport, uint32_t dst, uint16_t dport, const void *d, size_t n) {
+    if (!f || n > FL_PAYLOAD - sizeof(data_head) || !fl_is_virtual(dst)) return -1;
+    uint8_t b[FL_PAYLOAD]; LOCK; uint32_t me = own_ip(f); if (!me) { pthread_mutex_unlock(&f->m); return -1; }
+    data_head h = {me, dst, sport, dport}; memcpy(b, &h, sizeof h); if (n) memcpy(b + sizeof h, d, n); int bc = fl_is_broadcast(dst);
+    if (f->state == FL_CREATED) { for (int i = 0; i < f->set.npeers; i++) if (f->p[i].node > 0 && (bc || f->net.nodes[f->p[i].node].ip == dst)) put(f, &f->p[i], T_DATA, b, sizeof h + n); }
+    else if (f->host >= 0) put(f, &f->p[f->host], T_DATA, b, sizeof h + n);
+    pthread_mutex_unlock(&f->m); return 0;
+}
+int fl_friends_seen(friends_link *f) { if (!f) return 0; LOCK; int c = 0; for (int i = 0; i < f->set.npeers; i++) c += f->p[i].up; pthread_mutex_unlock(&f->m); return c; }
+fl_stats fl_get_stats(friends_link *f) { fl_stats s = {0}; if (!f) return s; LOCK; s = f->st; pthread_mutex_unlock(&f->m); return s; }
diff --git a/dm/host/friends_link.h b/dm/host/friends_link.h
new file mode 100644
index 00000000..caaf96e7
--- /dev/null
+++ b/dm/host/friends_link.h
@@ -0,0 +1,63 @@
+// Dockside friends link: local wireless between friends' Macs, and nothing else.
+// The game only ever sees a virtual network, 169.254.77.0/24; its packets travel inside one authenticated UDP socket to addresses the player listed.
+// No TCP, no names, no broadcast on the real network, no other host. Encryption is the private network's (Tailscale); this layer authenticates.
+// LDN record layouts follow switchbrew / libnx, as collected in nxnative PR #846 (RobiiAragon, MIT).
+#pragma once
+#include <netinet/in.h>
+#include <stddef.h>
+#include <stdint.h>
+typedef struct { uint8_t len; char text[33]; } fl_ssid;
+typedef struct { int64_t local_id; uint8_t r0[2]; uint16_t scene; uint8_t r1[4]; } fl_intent;
+typedef struct { fl_intent intent; uint8_t session[16]; } fl_id;
+typedef struct { uint32_t ip; uint8_t mac[6]; int8_t id; uint8_t connected; char name[33]; uint8_t platform; int16_t version; uint8_t r[16]; } fl_node;
+typedef struct { uint8_t mac[6]; fl_ssid ssid; int16_t channel; int8_t link; uint8_t type; uint8_t r[4]; } fl_common;
+typedef struct {
+    fl_id id; fl_common common; uint8_t security[16]; uint16_t security_mode; uint8_t accept_policy, version; uint8_t r0[2];
+    int8_t max_nodes; uint8_t node_count; fl_node nodes[8]; uint8_t r1[2]; uint16_t advertise_size; uint8_t advertise[384], r2[140]; uint64_t r3;
+} fl_network;
+typedef struct { fl_intent intent; int16_t channel; int8_t max_nodes; uint8_t r0; int16_t version; uint8_t r1[10]; } fl_config;
+typedef struct { uint16_t mode, size; uint8_t pass[64]; } fl_security;
+typedef struct { uint8_t server_random[16], session[16]; } fl_secparam;
+typedef struct { char name[33]; uint8_t r[15]; } fl_user;
+typedef struct { fl_id id; uint32_t type; uint8_t mac[6]; fl_ssid ssid; uint8_t r[16]; uint32_t flags; } fl_filter;
+typedef struct { uint8_t change, r[7]; } fl_update;
+_Static_assert(sizeof(fl_node) == 0x40 && sizeof(fl_network) == 0x480 && offsetof(fl_network, nodes) == 0x68 && offsetof(fl_network, advertise) == 0x26c, "LDN layout");
+_Static_assert(sizeof(fl_config) == 0x20 && sizeof(fl_filter) == 0x60, "LDN layout");
+#define FL_NET 0xA9FE4D00u   // 169.254.77.0, the virtual network (host byte order)
+#define FL_MASK 0xFFFFFF00u
+enum { FL_NONE, FL_INIT, FL_AP, FL_CREATED, FL_STATION, FL_CONNECTED };
+#define FL_ERR(n) (((uint32_t)(n) << 9) | 203u)
+enum { FL_E_STATE = FL_ERR(32), FL_E_CONNECT = FL_ERR(64), FL_E_NOTFOUND = FL_ERR(65), FL_E_TIMEOUT = FL_ERR(66), FL_E_REJECTED = FL_ERR(67), FL_E_INVALID = FL_ERR(96), FL_E_DISABLED = FL_ERR(22) };
+enum { FL_PEERS = 7, FL_PAYLOAD = 4096, FL_PORT = 11477 };
+typedef struct { uint8_t key[32]; struct sockaddr_in peers[FL_PEERS]; int npeers; struct in_addr bind; uint16_t port; } fl_setup;
+typedef struct friends_link friends_link;
+typedef struct {
+    void (*data)(void *, uint32_t src, uint16_t sport, uint32_t dst, uint16_t dport, const void *, size_t);   // a game datagram for this Mac
+    void (*event)(void *);                                                                                    // state or room changed
+    void (*sleep_ms)(int); void *opaque;
+} fl_hooks;
+typedef struct { uint64_t rx, bad_source, bad_packet, bad_tag, replay, refused, tx; } fl_stats;
+int fl_load(const char *path, int allow_loopback, fl_setup *out, char *why, size_t whylen);   // 0, or -1 with the reason
+int fl_derive(const char *code, uint8_t key[32]);
+int fl_private_ip(uint32_t ip, int allow_loopback);
+friends_link *fl_start(const fl_setup *, const fl_hooks *);
+void fl_stop(friends_link *);
+uint32_t fl_open(friends_link *, int ap);
+uint32_t fl_close(friends_link *, int ap);
+int fl_state(friends_link *);
+int fl_reason(friends_link *);
+uint32_t fl_scan(friends_link *, fl_network *, int *count, int max, const fl_filter *);
+uint32_t fl_create(friends_link *, const fl_config *, const fl_security *, const fl_user *, const fl_secparam *);
+uint32_t fl_connect(friends_link *, const fl_network *, const fl_security *, const fl_user *, int version);
+uint32_t fl_connect_session(friends_link *, const uint8_t session[16], const fl_security *, const fl_user *, int version);
+uint32_t fl_leave(friends_link *, int host);
+uint32_t fl_info(friends_link *, fl_network *, fl_update *, int);
+uint32_t fl_advertise(friends_link *, const void *, size_t);
+uint32_t fl_policy(friends_link *, int);
+uint32_t fl_kick(friends_link *, uint32_t ip);
+uint32_t fl_address(friends_link *);          // this Mac's virtual address in the room, 0 outside one
+int fl_is_virtual(uint32_t ip);               // the virtual network or a broadcast address
+int fl_is_broadcast(uint32_t ip);
+int fl_send(friends_link *, uint16_t sport, uint32_t dst, uint16_t dport, const void *, size_t);
+int fl_friends_seen(friends_link *);
+fl_stats fl_get_stats(friends_link *);
diff --git a/dm/host/hle_friends_link.c b/dm/host/hle_friends_link.c
new file mode 100644
index 00000000..2dd5a6bb
--- /dev/null
+++ b/dm/host/hle_friends_link.c
@@ -0,0 +1,70 @@
+// nn::ldn over the friends link (friends_link.c). Off unless DM_FRIENDS=1 and the player's friends file is valid: then every call answers as the offline host does.
+#include "hle.h"
+#include "hle_net.h"
+#include "friends_link.h"
+#include <pthread.h>
+void dm_guest_sleep_ns(int64_t ns);
+static friends_link *g_fl; static uint64_t g_fl_events[16];
+static pthread_rwlock_t g_fl_l = PTHREAD_RWLOCK_INITIALIZER;   // written by Initialize / Finalize only
+int dm_friends_on(void) { static int on = -1; if (on < 0) { const char *e = getenv("DM_FRIENDS"); on = e && !strcmp(e, "1"); } return on; }
+static void fl_sleep(int ms) { dm_guest_sleep_ns((int64_t)ms * 1000000); }
+static void fl_event(void *o) { (void)o; for (int i = 0; i < 16; i++) { uint64_t id = __atomic_load_n(&g_fl_events[i], __ATOMIC_ACQUIRE); if (id && !hle_signal_system_event_binding(id)) __atomic_compare_exchange_n(&g_fl_events[i], &id, 0, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED); } }
+static void fl_data(void *o, uint32_t s, uint16_t sp, uint32_t d, uint16_t dp, const void *p, size_t n) { (void)o; dm_sk_deliver(s, sp, d, dp, p, n); }
+// For the socket service: is this virtual address one the game may use now, and sending to it
+int dm_friends_virtual(uint32_t ip) { return dm_friends_on() && fl_is_virtual(ip); }
+int dm_friends_broadcast(uint32_t ip) { return fl_is_broadcast(ip); }
+#define USE(expr, off) do { if (!dm_friends_on()) return off; pthread_rwlock_rdlock(&g_fl_l); __typeof__(expr) r_ = expr; pthread_rwlock_unlock(&g_fl_l); return r_; } while (0)
+uint32_t dm_friends_address(void) { USE(fl_address(g_fl), 0); }
+int dm_friends_send(uint16_t sp, uint32_t d, uint16_t dp, const void *p, size_t n) { USE(fl_send(g_fl, sp, d, dp, p, n), -1); }
+static Result fl_init(void) {
+    if (!dm_friends_on()) return RES_FAIL;
+    Result r = 0; pthread_rwlock_wrlock(&g_fl_l);
+    if (!g_fl) {
+        char path[1024], why[160]; const char *f = getenv("DM_FRIENDS_FILE"), *h = getenv("HOME"); fl_setup s;
+        if (f && *f) snprintf(path, sizeof path, "%s", f); else snprintf(path, sizeof path, "%s/Dockside/friends.txt", h ? h : "");
+        if (fl_load(path, 0, &s, why, sizeof why)) { LOG("friends link: off, %s", why); r = FL_E_DISABLED; }
+        else { fl_hooks k = {fl_data, fl_event, fl_sleep, NULL}; g_fl = fl_start(&s, &k); memset(&s, 0, sizeof s);
+            if (!g_fl) { LOG("friends link: off, this Mac's private address or port is not available"); r = FL_ERR(16); } else LOG("friends link: on, listed friends only"); }
+    }
+    pthread_rwlock_unlock(&g_fl_l); return r;
+}
+static void fl_fini(void) { if (!dm_friends_on()) return; pthread_rwlock_wrlock(&g_fl_l); friends_link *f = g_fl; g_fl = NULL; pthread_rwlock_unlock(&g_fl_l); for (int i = 0; i < 16; i++) __atomic_store_n(&g_fl_events[i], 0, __ATOMIC_RELEASE);
+    if (f) { fl_stats t = fl_get_stats(f); LOG("friends link: off; in %llu out %llu, refused: strangers %llu wrong code %llu broken %llu repeats %llu other %llu", t.rx, t.tx, t.bad_source, t.bad_tag, t.bad_packet, t.replay, t.refused); fl_stop(f); } }
+#define LDN(m, name, ...) HLE_FORCE(m, "local wireless: the friends link when the player turned it on, else cut", Result, name, __VA_ARGS__)
+LDN("_ZN2nn3ldn10InitializeEv", h_ldn_Init, void) { return fl_init(); }
+HLE_FORCE("_ZN2nn3ldn8FinalizeEv", "local wireless: closes the friends link", void, h_ldn_Fini, void) { fl_fini(); }
+HLE_FORCE("_ZN2nn3ldn8GetStateEv", "local wireless: state, 0 (none) when off", int, h_ldn_State, void) { USE(fl_state(g_fl), 0); }
+HLE_FORCE("_ZN2nn3ldn22AttachStateChangeEventEPNS_2os15SystemEventTypeE", "local wireless state event: bound; fires only with the friends link", void, h_ldn_Attach, void *ev) {
+    hle_bind_system_event(ev, dm_friends_on()); if (!dm_friends_on()) return;
+    uint64_t id = hle_system_event_binding(ev); for (int i = 0; i < 16; i++) { uint64_t z = 0; if (__atomic_compare_exchange_n(&g_fl_events[i], &z, id, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED) || z == id) return; }
+}
+LDN("_ZN2nn3ldn11OpenStationEv", h_ldn_OpenSta, void) { USE(fl_open(g_fl, 0), RES_FAIL); }
+LDN("_ZN2nn3ldn12CloseStationEv", h_ldn_CloseSta, void) { USE(fl_close(g_fl, 0), RES_FAIL); }
+LDN("_ZN2nn3ldn15OpenAccessPointEv", h_ldn_OpenAp, void) { USE(fl_open(g_fl, 1), RES_FAIL); }
+LDN("_ZN2nn3ldn16CloseAccessPointEv", h_ldn_CloseAp, void) { USE(fl_close(g_fl, 1), RES_FAIL); }
+LDN("_ZN2nn3ldn10DisconnectEv", h_ldn_Disc, void) { USE(fl_leave(g_fl, 0), RES_FAIL); }
+LDN("_ZN2nn3ldn14DestroyNetworkEv", h_ldn_Destroy, void) { USE(fl_leave(g_fl, 1), RES_FAIL); }
+static Result scan(fl_network *o, int *n, int max, const fl_filter *q) { if (n) *n = 0; USE(fl_scan(g_fl, o, n, max, q), RES_FAIL); }
+LDN("_ZN2nn3ldn4ScanEPNS0_11NetworkInfoEPiiRKNS0_10ScanFilterEi", h_ldn_Scan, fl_network *o, int *n, int max, const fl_filter *q, int ch) { (void)ch; return scan(o, n, max, q); }
+LDN("_ZN2nn3ldn11ScanPrivateEPNS0_11NetworkInfoEPiiRKNS0_10ScanFilterEi", h_ldn_ScanP, fl_network *o, int *n, int max, const fl_filter *q, int ch) { (void)ch; return scan(o, n, max, q); }
+static Result create(const fl_config *c, const fl_security *s, const fl_secparam *p, const fl_user *u) { USE(fl_create(g_fl, c, s, u, p), RES_FAIL); }
