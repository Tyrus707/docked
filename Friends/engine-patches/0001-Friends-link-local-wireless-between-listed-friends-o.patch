+// The friends link on loopback: rooms, game packets, and everything that must be refused. clang t_friends_link.c ../friends_link.c
+#include "../friends_link.h"
+#include <CommonCrypto/CommonCrypto.h>
+#include <arpa/inet.h>
+#include <fcntl.h>
