+// The game's sockets over the friends link, two "Macs" in two processes: the socket service (hle_net.c) with the real link under it.
+#include "../hle_net.c"
+__thread _Atomic int dm_host_work;
+uint64_t guest_ns(void) { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW); }
+int dm_detclock_enabled(void) { return 0; }
+#include "../friends_link.h"
+#include <arpa/inet.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+void dm_guest_sleep_ns(int64_t ns) { struct timespec ts = {ns / 1000000000, ns % 1000000000}; nanosleep(&ts, NULL); }
+void dm_guest_cond_wait_ns(pthread_cond_t *c, pthread_mutex_t *m, int64_t ns) { struct timespec ts = {ns / 1000000000, ns % 1000000000}; pthread_cond_timedwait_relative_np(c, m, &ts); }
+static friends_link *L; static int ok, bad;
+#define CK(c, w) do { if (c) ok++; else { bad++; printf("FAIL %d: %s (errno %d)\n", __LINE__, w, dm_sk_errno()); } } while (0)
+int dm_friends_on(void) { return 1; } int dm_friends_virtual(uint32_t ip) { return fl_is_virtual(ip); } int dm_friends_broadcast(uint32_t ip) { return fl_is_broadcast(ip); }
+uint32_t dm_friends_address(void) { return fl_address(L); } int dm_friends_send(uint16_t s, uint32_t d, uint16_t p, const void *b, size_t n) { return fl_send(L, s, d, p, b, n); }
+static void nap(int m) { dm_guest_sleep_ns((int64_t)m * 1000000); }
+static void data(void *o, uint32_t s, uint16_t sp, uint32_t d, uint16_t dp, const void *p, size_t n) { (void)o; dm_sk_deliver(s, sp, d, dp, p, n); }
+static void sa(uint8_t b[16], uint32_t ip, uint16_t port) { memset(b, 0, 16); b[0] = 16; b[1] = 2; b[2] = port >> 8; b[3] = (uint8_t)port; b[4] = ip >> 24; b[5] = ip >> 16; b[6] = ip >> 8; b[7] = (uint8_t)ip; }
+static uint32_t sip(const uint8_t b[16]) { return (uint32_t)b[4] << 24 | b[5] << 16 | b[6] << 8 | b[7]; }
+int main(void) {
+    int child = fork() == 0, me = child ? 21102 : 21101, other = child ? 21101 : 21102;
+    fl_setup s = {.port = (uint16_t)me, .npeers = 1}; s.bind.s_addr = htonl(0x7f000001); memset(s.key, 7, 32); s.peers[0] = (struct sockaddr_in){.sin_len = 16, .sin_family = AF_INET, .sin_port = htons((uint16_t)other), .sin_addr = s.bind};
+    fl_hooks h = {data, NULL, nap, NULL}; L = fl_start(&s, &h); CK(L, "start"); for (int i = 0; i < 400 && !fl_friends_seen(L); i++) nap(10);
+    fl_config c = {.max_nodes = 4, .version = 1}; fl_security q = {0}; fl_user u = {"P"}; fl_network n[2]; int k = 0;
+    if (child) { fl_open(L, 0); for (int i = 0; i < 8 && !k; i++) fl_scan(L, n, &k, 2, NULL); CK(k == 1 && !fl_connect(L, n, &q, &u, 1), "join"); } else { fl_open(L, 1); CK(!fl_create(L, &c, &q, &u, NULL), "create"); }
+    for (int i = 0; i < 500; i++) { if (!fl_info(L, n, NULL, 0) && n[0].node_count == 2) break; nap(10); } CK(n[0].node_count == 2, "both in the room");
+    uint32_t mine = fl_address(L), his = child ? FL_NET + 1 : FL_NET + 2; CK(mine == (child ? FL_NET + 2 : FL_NET + 1), "addresses");
+    int f = dm_sk_socket(2, 2, 17); uint8_t a[16]; int one = 1; CK(f >= 0 && !dm_sk_setopt(f, 0xffff, 0x20, &one, 4) && !dm_sk_setopt(f, 0xffff, 0x9999, &one, 4) && !dm_sk_fcntl(f, 4, 0x800), "socket"); sa(a, 0, 12345); CK(!dm_sk_bind(f, a, 16), "bind any");
+    int g = dm_sk_socket(2, 2, 0); sa(a, mine, 12346); CK(!dm_sk_bind(g, a, 16), "bind own address"); int lo = dm_sk_socket(2, 2, 0); sa(a, 0x7f000001, 12347); CK(!dm_sk_bind(lo, a, 16), "bind loopback"); nap(300);
+    char b[4096]; unsigned al; long r = -1; int got = 0, wrong = 0; sa(a, his, 12345);
+    for (int i = 0; i < 600; i++) { memcpy(b, &i, 4); memset(b + 4, i, 600); CK(dm_sk_sendto(f, b, 604, 0, a, 16) == 604, "send"); uint8_t fr[16]; al = 16; while ((r = dm_sk_recvfrom(f, b, sizeof b, 0x80, fr, &al)) > 0) { int v; memcpy(&v, b, 4); got++; if (r != 604 || sip(fr) != his || fr[2] != 12345 >> 8 || (uint8_t)b[4] != (uint8_t)v) wrong++; } nap(2); }
+    nap(400); while ((r = dm_sk_recvfrom(f, b, sizeof b, 0x80, NULL, NULL)) > 0) got++; CK(got >= 590 && !wrong, "600 game packets arrive, unchanged and from the right address"); if (!child) printf("game packets: %d of 600 arrived\n", got);
+    sa(a, FL_NET + 255, 12346); CK(dm_sk_sendto(g, "bc", 2, 0, a, 16) == 2, "broadcast"); sa(a, his, 12347); dm_sk_sendto(f, "no", 2, 0, a, 16); struct { int32_t fd; int16_t e, r; } pf = {g, 1, 0}; CK(dm_sk_poll(&pf, 1, 2000) == 1 && pf.r & 1, "poll wakes"); CK(dm_sk_recvfrom(g, b, sizeof b, 0x80, NULL, NULL) == 2 && !memcmp(b, "bc", 2), "broadcast arrives"); nap(200); CK(dm_sk_recvfrom(lo, b, sizeof b, 0x80, NULL, NULL) < 0, "a loopback socket hears no friend");
+    static const uint32_t out[] = {0x08080808, 0xC0A80001, 0x64400001, 0xA9FE0101, 0xE0000001, 0x0A000001}; for (int i = 0; i < 6; i++) { sa(a, out[i], 80); CK(dm_sk_sendto(f, "x", 1, 0, a, 16) == -1, "no real address can be reached"); CK(dm_sk_connect(g, a, 16) == -1, "or connected"); }
+    CK(dm_sk_socket(2, 1, 6) == -1, "no TCP"); sa(a, 0x7f000001, 12347); CK(dm_sk_sendto(f, "lo", 2, 0, a, 16) == 2, "loopback still works"); nap(20); CK(dm_sk_recvfrom(lo, b, sizeof b, 0x80, NULL, NULL) == 2, "and arrives");
+    nap(400); fl_stop(L); sa(a, his, 12345); L = NULL; CK(dm_sk_sendto(f, "x", 1, 0, a, 16) == 1, "with the link closed a packet is just lost");
+    if (child) { if (bad) printf("child: %d failed\n", bad); fflush(stdout); _exit(bad != 0); } int st; wait(&st); bad += WEXITSTATUS(st) != 0; printf("friends sockets: %d passed, %d failed\n", ok, bad); return bad != 0;
+}
