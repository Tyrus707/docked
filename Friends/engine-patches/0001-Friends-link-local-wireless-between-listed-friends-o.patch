+static int ok, bad; 
+#define CK(c, w) do { if (c) ok++; else { bad++; printf("FAIL %d: %s\n", __LINE__, w); } } while (0)
+static void nap(int m) { struct timespec t = {m / 1000, (m % 1000) * 1000000L}; nanosleep(&t, NULL); }
+typedef struct { pthread_mutex_t m; int n; uint32_t src, dst; uint16_t sp, dp; uint8_t d[4096]; size_t len; int ev; } box;
+static void got(void *o, uint32_t s, uint16_t sp, uint32_t d, uint16_t dp, const void *p, size_t n) { box *b = o; pthread_mutex_lock(&b->m); b->n++; b->src = s; b->dst = d; b->sp = sp; b->dp = dp; b->len = n; memcpy(b->d, p, n); pthread_mutex_unlock(&b->m); }
+static void ev(void *o) { __atomic_add_fetch(&((box *)o)->ev, 1, __ATOMIC_RELAXED); }
+static int cnt(box *b) { pthread_mutex_lock(&b->m); int n = b->n; pthread_mutex_unlock(&b->m); return n; }
+static struct sockaddr_in at(int port) { struct sockaddr_in a = {.sin_len = 16, .sin_family = AF_INET, .sin_port = htons((uint16_t)port)}; a.sin_addr.s_addr = htonl(0x7f000001); return a; }
+static uint8_t KEY[32];
+static friends_link *mk(box *b, int port, const int *others, int n, const uint8_t *key) {
+    fl_setup s = {.port = (uint16_t)port, .npeers = n}; s.bind.s_addr = htonl(0x7f000001); memcpy(s.key, key, 32); for (int i = 0; i < n; i++) s.peers[i] = at(others[i]);
+    memset(b, 0, sizeof *b); pthread_mutex_init(&b->m, NULL); fl_hooks h = {got, ev, nap, b}; return fl_start(&s, &h);
+}
+#define UNTIL(c, t) do { for (int i_ = 0; i_ < (t) / 10 && !(c); i_++) nap(10); } while (0)
+static int raw(int port) { int f = socket(AF_INET, SOCK_DGRAM, 0); struct sockaddr_in a = at(port); if (bind(f, (void *)&a, 16)) { perror("bind"); exit(1); } return f; }
+static void shoot(int f, int port, const void *d, size_t n) { struct sockaddr_in a = at(port); sendto(f, d, n, 0, (void *)&a, 16); }
+static size_t forge(uint8_t *b, int type, uint64_t s, uint64_t r, uint64_t c, const void *d, size_t n, const uint8_t *key) {
+    memset(b, 0, 32); memcpy(b, "DSF1", 4); b[4] = (uint8_t)type; memcpy(b + 8, &s, 8); memcpy(b + 16, &r, 8); memcpy(b + 24, &c, 8); if (n) memcpy(b + 32, d, n);
+    uint8_t t[32]; CCHmac(kCCHmacAlgSHA256, key, 32, b, 32 + n, t); memcpy(b + 32 + n, t, 16); return 48 + n;
+}
+static char why[200];
+static int load(const char *text, int mode, int loop) { char p[] = "/tmp/fl_XXXXXX"; int f = mkstemp(p); (void)!write(f, text, strlen(text)); fchmod(f, (mode_t)mode); close(f); fl_setup s; int r = fl_load(p, loop, &s, why, sizeof why); unlink(p); return r; }
+int main(void) {
