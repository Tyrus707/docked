+++ b/dm/host/hle_net.c
@@ -39,9 +39,15 @@ HLE_FORCE("nnsslFinalize", "pairs with nnsslInitialize (cut)", Result, h_ssl_Fin
 // these structures/flags unchanged; FreeBSD11 sys/socket.h and netinet/in.h). IPv4 payloads retain packet boundaries; the per-endpoint queue holds at most256 packets/1MiB.
 #define SK_ENETDOWN 50
 static __thread int t_skerr = SK_ENETDOWN;
-static int sk_error(int error) { t_skerr = error; return -1; }
+static int sk_trace(void) { static int on = -1; if (on < 0) { const char *e = getenv("DM_FRIENDS_TRACE"); on = e && *e == '1'; } return on; }
+static int sk_error(int error) { t_skerr = error; { static _Atomic int c; const char *e = getenv("DM_FRIENDS_TRACE"); if (e && *e == '1' && error != 35 && atomic_fetch_add(&c, 1) < 30) LOG("friends trace: socket error %d", error); } return -1; }
 static int sk_fail(void) { return sk_error(SK_ENETDOWN); }
-int dm_sk_errno(void) { return t_skerr; }
+// nn::socket::Errno is numbered as Linux's, not BSD's: a game that gets 35 for "nothing yet" takes it for a failure (Smash Ultimate's Pia closes its socket, error 2618-0006).
+// Only with the friends link, so that the offline host answers as it always has.
+int dm_sk_errno(void) {
+    if (!dm_friends_on()) return t_skerr;
+    switch (t_skerr) { case 35: return 11; case 36: return 115; case 39: return 89; case 40: return 90; case 42: return 92; case 45: return 95; case 48: return 98; case 49: return 99; case 50: return 100; case 55: return 105; case 57: return 107; default: return t_skerr; }
+}
 #define SKF(m, cname, ...) HLE_FORCE(m, "local BSD descriptor service; remote networking unavailable", int, cname, __VA_ARGS__)
 void dm_guest_sleep_ns(int64_t ns);
 void dm_guest_cond_wait_ns(pthread_cond_t *c, pthread_mutex_t *m, int64_t ns);
@@ -78,10 +84,12 @@ static int efd_create(uint64_t v, int flags) {
     pthread_mutex_unlock(&g_efd_m); return fd;
 }
