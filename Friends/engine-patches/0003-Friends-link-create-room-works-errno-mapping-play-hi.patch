diff --git a/dm/host/hle_friends.c b/dm/host/hle_friends.c
index 4003a4b0..064e8a82 100644
--- a/dm/host/hle_friends.c
+++ b/dm/host/hle_friends.c
@@ -2,6 +2,7 @@
 // Not cut: the getters of Friend / Profile / FriendPresence and the constructors of Friend / Profile / UserPresence (they only read and write the game's own objects and do not go through the service).
 // Unless stated otherwise (presence and the notification queue are local and succeed), Result returns RES_FAIL; bool returns false; event pointers get a SystemEvent that is bound to a kernel event and never fires.
 #include "hle.h"
+#include "hle_net.h"
 
 // Notification event that never fires (GetSystemEvent-style calls return a pointer; bound on the guest thread on first use)
 static _Alignas(16) uint8_t g_ev_notify[0x100], g_ev_invite[0x100];
@@ -43,13 +44,14 @@ HLE_FORCE("_ZN2nn7friends16UpdateFriendInfoEPNS0_6FriendEPKNS_7account23NetworkS
           Result, h_fr_UpdateFriendInfoNoUid, void *f, const void *ids, int n) { (void)f; (void)ids; (void)n; return RES_FAIL; }
 HLE_FORCE("_ZN2nn7friends6Friend6UpdateEv", "friend info update fails (cut)", Result, h_fr_FriendUpdate, void *self) { (void)self; return RES_FAIL; }
 HLE_FORCE("_ZN2nn7friends14AddPlayHistoryERKNS0_26PlayHistoryRegistrationKeyERKNS0_15InAppScreenNameES6_", "play history is not registered (cut)",
-          Result, h_fr_AddPlayHistory, const void *k, const void *a, const void *b) { (void)k; (void)a; (void)b; return RES_FAIL; }
+          Result, h_fr_AddPlayHistory, const void *k, const void *a, const void *b) { (void)k; (void)a; (void)b; return dm_friends_on() ? RES_OK : RES_FAIL; }
 HLE_FORCE("_ZN2nn7friends29GetPlayHistoryRegistrationKeyEPNS0_26PlayHistoryRegistrationKeyERKNS_7account3UidEb", "play history key unavailable (cut)",
-          Result, h_fr_GetPHKey, void *k, const void *uid, int local) { (void)k; (void)uid; (void)local; return RES_FAIL; }
+          // With the friends link a room needs one (Smash Ultimate closes its room without it). Only Nintendo's servers check what it says; between friends any 0x40 bytes will do.
+          Result, h_fr_GetPHKey, void *k, const void *uid, int local) { (void)uid; (void)local; if (!dm_friends_on() || !k) return RES_FAIL; arc4random_buf(k, 0x40); return RES_OK; }
 // The form without a Uid (SDK 20; Super Nintendo Entertainment System – Nintendo Classics 6.0.0 asks first thing in nnMain, main+0xc608): the SDK's own opens the friends service and
 // aborts with 0xe15 when it cannot; cut the same way as the Uid form
 HLE_FORCE("_ZN2nn7friends29GetPlayHistoryRegistrationKeyEPNS0_26PlayHistoryRegistrationKeyEb", "play history key unavailable (cut)",
-          Result, h_fr_GetPHKeyNoUid, void *k, int local) { (void)k; (void)local; return RES_FAIL; }
+          Result, h_fr_GetPHKeyNoUid, void *k, int local) { (void)local; if (!dm_friends_on() || !k) return RES_FAIL; arc4random_buf(k, 0x40); return RES_OK; }
 // Notification queue
 HLE_FORCE("_ZN2nn7friends17NotificationQueueC1Ev", "notification queue creates no session (cut)", void, h_fr_NqCtor, void *self) { (void)self; }
 HLE_FORCE("_ZN2nn7friends17NotificationQueueD1Ev", "notification queue has no session to close (cut)", void, h_fr_NqDtor, void *self) { (void)self; }
