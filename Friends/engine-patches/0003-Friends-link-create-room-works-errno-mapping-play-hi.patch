+    { static _Atomic int c; if (sk_trace() && atomic_fetch_add(&c, 1) < 40) LOG("friends trace: sendto fd %d size %lu flags %#x to %02x%02x%02x%02x:%u", fd, n, flags, a ? ((const uint8_t *)a)[4] : 0, a ? ((const uint8_t *)a)[5] : 0, a ? ((const uint8_t *)a)[6] : 0, a ? ((const uint8_t *)a)[7] : 0, a ? ((const uint8_t *)a)[2] << 8 | ((const uint8_t *)a)[3] : 0); }
     if (flags & ~(SK_MSG_DONTWAIT | 4 | 0x20000)) return sk_error(SK_EOPNOTSUPP);
     uint32_t addr = 0; uint16_t port = 0; if (a && sk_addr_read(a, al, &addr, &port)) return -1;
     dm_host_mutex_lock(&g_efd_m); long r = -1;
@@ -287,6 +301,7 @@ long dm_sk_write(int fd, const void *data, unsigned long size) {
 }
