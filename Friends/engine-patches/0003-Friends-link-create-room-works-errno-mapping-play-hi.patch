     if (!f) return FL_E_DISABLED; if (!c || !s || !u || s->size > 64 || c->max_nodes < 1 || c->max_nodes > 8 || !memchr(u->name, 0, sizeof u->name)) return FL_E_INVALID;
     LOCK; if (f->state != FL_AP) UNLOCK(FL_E_STATE);
