+static void let_go(friends_path *f) { if (__atomic_sub_fetch(&f->refs, 1, __ATOMIC_ACQ_REL)) return; pthread_mutex_destroy(&f->m); memset_s(f, sizeof *f, 0, sizeof *f); free(f); }
