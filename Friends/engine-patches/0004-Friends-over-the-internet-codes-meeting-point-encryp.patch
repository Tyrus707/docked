--- /dev/null
+++ b/dm/host/friends_path.h
@@ -0,0 +1,26 @@
+// The way to a friend over the internet: finds every address this Mac can be reached at, tries them all at once, and uses the best one that answers.
+// Home network, then direct internet (IPv6 or IPv4), and a relay only when asked for. Everything on the wire is sealed (friends_crypto.h).
+#pragma once
+#include "friends_crypto.h"
+#include <netinet/in.h>
+enum { FP_SLOTS = 7, FP_CANDS = 10, FP_MAX = 4096 + 128 };
+typedef struct { uint8_t kind, fam; uint16_t port; uint8_t addr[16]; } fp_cand;   // kind: 1 home network, 2 internet, 3 relay; port in host order
+typedef struct friends_path friends_path;
+typedef struct {
+    void (*data)(void *, int slot, const uint8_t *, size_t);   // a friend's packet, opened and checked
+    void (*cands)(void *);                                     // this Mac's addresses changed
+    void *opaque; const char *stun_host; uint16_t stun_port; const char *turn_host; uint16_t turn_port; int loopback;
+} fp_hooks;
+typedef struct { int up, relay, v6, home; double rtt; uint64_t since_ms, quiet_ms; } fp_state;   // quiet: since anything genuine came from the friend, UINT64_MAX when nothing has, or they said goodbye
+typedef struct { uint64_t rx, tx, stranger, forged, replay, odd; } fp_stats;
+friends_path *fp_start(const fp_hooks *);
+void fp_stop(friends_path *);
+int fp_candidates(friends_path *, fp_cand out[FP_CANDS]);
+int fp_session(friends_path *, int slot, const fc_keys *);       // a new session in this slot (replaces any)
+void fp_remote(friends_path *, int slot, const fp_cand *, int n);
+void fp_drop(friends_path *, int slot);
+int fp_send(friends_path *, int slot, const void *, size_t);     // 0 when sent
+void fp_relay(friends_path *, const char *user, const char *credential);
+fp_state fp_get(friends_path *, int slot);
+fp_stats fp_get_stats(friends_path *);
+int fp_cand_ok(const fp_cand *, const struct in_addr *ips, const struct in_addr *masks, int n, int loopback);
