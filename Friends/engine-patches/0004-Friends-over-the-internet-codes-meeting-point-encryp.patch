+#!/usr/bin/env python3
+"""Test only: a small STUN/TURN server on 127.0.0.1 (RFC 8489 / 8656), written from the RFCs apart from friends_path.c. turn_server.py <user> <credential> -> prints its port"""
+import hashlib, hmac, os, select, socket, struct, sys, time
+USER, PW = sys.argv[1].encode(), sys.argv[2].encode(); REALM = b'test.realm'; NONCES = {b'n0'}; COOKIE = 0x2112A442
+KEY = hashlib.md5(USER + b':' + REALM + b':' + PW).digest()
+main = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); main.bind(('127.0.0.1', int(sys.argv[3]) if len(sys.argv) > 3 else 0)); print(main.getsockname()[1], flush=True)
+allocs = {}  # client -> dict(sock, perms{ip: t}, chans{num: peer}, by{peer: num})
+def attrs(b):
+    o, i = {}, 20
+    while i + 4 <= len(b):
+        t, l = struct.unpack_from('>HH', b, i); o.setdefault(t, (b[i+4:i+4+l], i)); i += 4 + ((l + 3) & ~3)
+    return o
+def attr(t, v): return struct.pack('>HH', t, len(v)) + v + b'\0' * (-len(v) % 4)
+def xaddr(t, a): return attr(t, struct.pack('>BBH', 0, 1, a[1] ^ (COOKIE >> 16)) + struct.pack('>I', struct.unpack('>I', socket.inet_aton(a[0]))[0] ^ COOKIE))
+def unx(v): return (socket.inet_ntoa(struct.pack('>I', struct.unpack('>I', v[4:8])[0] ^ COOKIE)), struct.unpack('>H', v[2:4])[0] ^ (COOKIE >> 16))
+def msg(t, tid, body, sign=False):
+    if sign:
+        h = struct.pack('>HHI', t, len(body) + 24, COOKIE) + tid + body; body += attr(8, hmac.new(KEY, h, hashlib.sha1).digest())
+    return struct.pack('>HHI', t, len(body), COOKIE) + tid + body
+def err(t, tid, code, reason, extra=b''): return msg(t | 0x110, tid, attr(9, struct.pack('>HBB', 0, code // 100, code % 100) + reason) + extra)
+def authed(b, a):
+    if 8 not in a or 6 not in a or 0x14 not in a or 0x15 not in a: return False
+    at = a[8][1]; h = bytearray(b[:at]); struct.pack_into('>H', h, 2, at - 20 + 24)
+    return a[6][0] == USER and a[0x14][0] == REALM and hmac.compare_digest(hmac.new(KEY, bytes(h), hashlib.sha1).digest(), a[8][0])
+stale_once = len(sys.argv) > 4
+while True:
+    socks = [main] + [x['sock'] for x in allocs.values()]
+    for s in select.select(socks, [], [], 1)[0]:
+        b, src = s.recvfrom(65536)
+        if s is not main:
+            c, al = next((k, v) for k, v in allocs.items() if v['sock'] is s)
+            if src[0] not in al['perms']: continue
+            n = al['by'].get(src)
+            main.sendto(struct.pack('>HH', n, len(b)) + b if n else msg(0x17, os.urandom(12), xaddr(0x12, src) + attr(0x13, b)), c); continue
+        if len(b) >= 4 and 0x40 <= b[0] <= 0x7f:
+            al = allocs.get(src); n, l = struct.unpack_from('>HH', b)
+            if al and n in al['chans'] and al['chans'][n][0] in al['perms']: al['sock'].sendto(b[4:4+l], al['chans'][n])
+            continue
+        if len(b) < 20 or struct.unpack_from('>I', b, 4)[0] != COOKIE: continue
+        t = struct.unpack_from('>H', b)[0]; tid = b[8:20]; a = attrs(b)
+        if t == 1: main.sendto(msg(0x101, tid, xaddr(0x20, src)), src); continue
+        if t == 0x16:
+            al = allocs.get(src)
+            if al and 0x12 in a and 0x13 in a and unx(a[0x12][0])[0] in al['perms']: al['sock'].sendto(a[0x13][0], unx(a[0x12][0]))
+            continue
+        if t not in (3, 4, 8, 9): continue
+        ch = attr(0x14, REALM) + attr(0x15, b'n0' if not stale_once else b'n1')
