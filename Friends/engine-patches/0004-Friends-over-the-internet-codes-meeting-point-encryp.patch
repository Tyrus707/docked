+static int alive(const path *p, uint64_t now) { return p->ack && now - p->ack < DEAD_MS; }
+static int relayed(const path *p) { return p->relay || p->far; }
+static double cost(const path *p) { return p->rtt + (relayed(p) ? RELAY_COST : 0) - (p->home ? 3 : 0); }
