diff --git a/dm/host/friends_crypto.c b/dm/host/friends_crypto.c
new file mode 100644
index 0000000..ee4557e
--- /dev/null
+++ b/dm/host/friends_crypto.c
@@ -0,0 +1,83 @@
+#include "friends_crypto.h"
+#include <CommonCrypto/CommonCrypto.h>
+#include <string.h>
+#include <ctype.h>
+static SecKeyRef import_key(const uint8_t *d, size_t n, CFStringRef cls) {
+    CFDataRef c = CFDataCreate(NULL, d, (CFIndex)n); int bits = 256; CFNumberRef b = CFNumberCreate(NULL, kCFNumberIntType, &bits);
+    const void *k[] = {kSecAttrKeyType, kSecAttrKeyClass, kSecAttrKeySizeInBits}, *v[] = {kSecAttrKeyTypeECSECPrimeRandom, cls, b};
+    CFDictionaryRef a = CFDictionaryCreate(NULL, k, v, 3, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    SecKeyRef r = SecKeyCreateWithData(c, a, NULL); CFRelease(a); CFRelease(b); CFRelease(c); return r;
+}
+SecKeyRef fc_new_key(void) {
+    int bits = 256; CFNumberRef b = CFNumberCreate(NULL, kCFNumberIntType, &bits); const void *k[] = {kSecAttrKeyType, kSecAttrKeySizeInBits}, *v[] = {kSecAttrKeyTypeECSECPrimeRandom, b};
+    CFDictionaryRef a = CFDictionaryCreate(NULL, k, v, 2, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks); SecKeyRef r = SecKeyCreateRandomKey(a, NULL); CFRelease(a); CFRelease(b); return r;
+}
+static int copy_out(CFDataRef d, uint8_t *o, size_t n) { int ok = d && (size_t)CFDataGetLength(d) == n; if (ok) memcpy(o, CFDataGetBytePtr(d), n); if (d) CFRelease(d); return ok ? 0 : -1; }
+int fc_export(SecKeyRef p, uint8_t o[97]) { return p ? copy_out(SecKeyCopyExternalRepresentation(p, NULL), o, 97) : -1; }
+SecKeyRef fc_import(const uint8_t in[97]) { return import_key(in, 97, kSecAttrKeyClassPrivate); }
+int fc_public(SecKeyRef p, uint8_t o[FC_KEY]) { SecKeyRef u = p ? SecKeyCopyPublicKey(p) : NULL; if (!u) return -1; int r = copy_out(SecKeyCopyExternalRepresentation(u, NULL), o, FC_KEY); CFRelease(u); return r; }
+// A signature travels as two plain 32-byte numbers; Security.framework speaks the same two numbers in DER
+static int der_to_raw(const uint8_t *d, size_t n, uint8_t o[FC_SIG]) {
+    if (n < 8 || n > 72 || d[0] != 0x30 || d[1] != n - 2) return -1; size_t i = 2; memset(o, 0, FC_SIG);
+    for (int k = 0; k < 2; k++) { if (i + 2 > n || d[i] != 2) return -1; size_t l = d[i + 1]; i += 2; if (!l || l > 33 || i + l > n) return -1; const uint8_t *v = d + i; i += l; if (l == 33) { if (*v) return -1; v++; l--; } memcpy(o + 32 * k + 32 - l, v, l); }
+    return i == n ? 0 : -1;
+}
+static size_t raw_to_der(const uint8_t s[FC_SIG], uint8_t o[72]) {
+    size_t n = 2; for (int k = 0; k < 2; k++) { const uint8_t *v = s + 32 * k; size_t l = 32; while (l > 1 && !*v) { v++; l--; } int pad = *v >> 7; o[n++] = 2; o[n++] = (uint8_t)(l + (size_t)pad); if (pad) o[n++] = 0; memcpy(o + n, v, l); n += l; }
+    o[0] = 0x30; o[1] = (uint8_t)(n - 2); return n;
+}
+int fc_sign(SecKeyRef p, const void *d, size_t n, uint8_t s[FC_SIG]) {
+    CFDataRef c = CFDataCreate(NULL, d, (CFIndex)n), r = p ? SecKeyCreateSignature(p, kSecKeyAlgorithmECDSASignatureMessageX962SHA256, c, NULL) : NULL; CFRelease(c);
+    int bad = !r || der_to_raw(CFDataGetBytePtr(r), (size_t)CFDataGetLength(r), s); if (r) CFRelease(r); return bad ? -1 : 0;
+}
+int fc_verify(const uint8_t pub[FC_KEY], const void *d, size_t n, const uint8_t sig[FC_SIG]) {
+    SecKeyRef k = pub[0] == 4 ? import_key(pub, FC_KEY, kSecAttrKeyClassPublic) : NULL; if (!k) return 0; uint8_t der[72]; size_t dn = raw_to_der(sig, der);
+    CFDataRef c = CFDataCreate(NULL, d, (CFIndex)n), s = CFDataCreate(NULL, der, (CFIndex)dn); int ok = SecKeyVerifySignature(k, kSecKeyAlgorithmECDSASignatureMessageX962SHA256, c, s, NULL); CFRelease(c); CFRelease(s); CFRelease(k); return ok;
+}
+static const char ALPHABET[] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+void fc_code(const uint8_t pub[FC_KEY], char o[FC_CODE + 1]) {
+    uint8_t h[32]; CC_SHA256_CTX c; CC_SHA256_Init(&c); CC_SHA256_Update(&c, "docked-friend-code-v1", 21); CC_SHA256_Update(&c, pub, FC_KEY); CC_SHA256_Final(h, &c);
+    uint32_t acc = 0; int n = 0, k = 0; for (int i = 0; i < 10; i++) { acc = acc << 8 | h[i]; n += 8; while (n >= 5) { n -= 5; o[k++] = ALPHABET[acc >> n & 31]; } acc &= (1u << n) - 1; } o[k] = 0;
+}
+int fc_clean_code(const char *t, char o[FC_CODE + 1]) {
+    int k = 0; for (; *t; t++) { char c = (char)toupper((unsigned char)*t); if (c == '-' || isspace((unsigned char)c)) continue; if (c == 'O') c = '0'; if (c == 'I' || c == 'L') c = '1';
+        if (k == FC_CODE || !strchr(ALPHABET, c)) return 0; o[k++] = c; }
+    o[k] = 0; return k == FC_CODE;
+}
+int fc_eq(const void *a, const void *b, size_t n) { const volatile uint8_t *x = a, *y = b; uint8_t v = 0; for (size_t i = 0; i < n; i++) v |= x[i] ^ y[i]; return !v; }
+void fc_hmac256(const void *k, size_t kn, const void *d, size_t n, uint8_t o[32]) { CCHmac(kCCHmacAlgSHA256, k, kn, d, n, o); }
+enum { SAID = 13 + FC_CODE * 2 + FC_KEY + FC_NONCE };
+static void said(const char *from, const char *to, const fc_hi *h, uint8_t o[SAID]) { memcpy(o, "docked-hi-v1|", 13); memcpy(o + 13, from, FC_CODE); memcpy(o + 13 + FC_CODE, to, FC_CODE); memcpy(o + 13 + 2 * FC_CODE, h->eph, FC_KEY); memcpy(o + 13 + 2 * FC_CODE + FC_KEY, h->nonce, FC_NONCE); }
+int fc_make_hi(SecKeyRef id, SecKeyRef eph, const char *to, fc_hi *o) {
+    char me[FC_CODE + 1]; uint8_t b[SAID]; if (strlen(to) != FC_CODE || fc_public(id, o->key) || fc_public(eph, o->eph)) return -1;
+    arc4random_buf(o->nonce, FC_NONCE); fc_code(o->key, me); said(me, to, o, b); return fc_sign(id, b, sizeof b, o->sig);
+}
+int fc_check_hi(const fc_hi *h, const char *from, const char *to) {
+    char c[FC_CODE + 1]; uint8_t b[SAID]; if (strlen(from) != FC_CODE || strlen(to) != FC_CODE) return 0; fc_code(h->key, c); if (strcmp(c, from)) return 0; said(from, to, h, b); return fc_verify(h->key, b, sizeof b, h->sig);
+}
+int fc_session(SecKeyRef eph, const fc_hi *mine, const fc_hi *theirs, fc_keys *o) {
+    uint8_t secret[32], salt[32], prk[32]; memset(o, 0, sizeof *o); if (theirs->eph[0] != 4 || fc_eq(mine->key, theirs->key, FC_KEY) || fc_eq(mine->eph, theirs->eph, FC_KEY)) return -1;
+    SecKeyRef pub = import_key(theirs->eph, FC_KEY, kSecAttrKeyClassPublic); if (!pub) return -1;
+    CFDictionaryRef none = CFDictionaryCreate(NULL, NULL, NULL, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    int bad = copy_out(SecKeyCopyKeyExchangeResult(eph, kSecKeyAlgorithmECDHKeyExchangeStandard, pub, none, NULL), secret, 32); CFRelease(none); CFRelease(pub); if (bad) return -1;
+    int first = memcmp(mine->key, theirs->key, FC_KEY) < 0; const fc_hi *a = first ? mine : theirs, *b = first ? theirs : mine;
+    CC_SHA256_CTX c; CC_SHA256_Init(&c); CC_SHA256_Update(&c, "docked-session-v1", 17); CC_SHA256_Update(&c, a, offsetof(fc_hi, sig)); CC_SHA256_Update(&c, b, offsetof(fc_hi, sig)); CC_SHA256_Final(salt, &c);
+    fc_hmac256(salt, 32, secret, 32, prk);
+    fc_way *w[4] = {first ? &o->out : &o->in, first ? &o->in : &o->out, first ? &o->note_out : &o->note_in, first ? &o->note_in : &o->note_out};
+    for (uint8_t i = 0; i < 4; i++) { uint8_t t[32]; for (uint8_t k = 0; k < 3; k++) { uint8_t info[] = {'w', i, k, 1}; fc_hmac256(prk, 32, info, sizeof info, t); if (k == 0) memcpy(w[i]->enc, t, 32); else if (k == 1) memcpy(w[i]->mac, t, 32); else memcpy(&w[i]->sid, t, 4); } }
+    uint8_t info[] = {'l', 0, 0, 1}; fc_hmac256(prk, 32, info, sizeof info, o->link); memset_s(secret, 32, 0, 32); memset_s(prk, 32, 0, 32); return 0;
+}
+static void ctr(const uint8_t key[32], const uint8_t head[FC_HEAD], const void *in, size_t n, uint8_t *out) {   // the counter never repeats under one key, so neither does the stream
+    uint8_t iv[16] = {0}; memcpy(iv, head + 8, 8); CCCryptorRef c; size_t m = 0;
+    if (CCCryptorCreateWithMode(kCCEncrypt, kCCModeCTR, kCCAlgorithmAES, ccNoPadding, iv, key, 32, NULL, 0, 0, kCCModeOptionCTR_BE, &c) != kCCSuccess) { memset(out, 0, n); return; }
+    if (CCCryptorUpdate(c, in, n, out, n, &m) != kCCSuccess) memset(out, 0, n); CCCryptorRelease(c);
+}
+void fc_seal(const fc_way *w, uint8_t type, uint64_t counter, const void *d, size_t n, uint8_t *o) {
+    o[0] = 'D'; o[1] = 'I'; o[2] = type; o[3] = 1; memcpy(o + 4, &w->sid, 4); memcpy(o + 8, &counter, 8); if (n) ctr(w->enc, o, d, n, o + FC_HEAD);
+    uint8_t t[32]; fc_hmac256(w->mac, 32, o, FC_HEAD + n, t); memcpy(o + FC_HEAD + n, t, FC_TAG);
+}
+int fc_open(const fc_way *w, const uint8_t *b, size_t n, uint8_t *o, uint64_t *counter) {
+    if (n < FC_HEAD + FC_TAG || b[0] != 'D' || b[1] != 'I' || b[3] != 1 || memcmp(b + 4, &w->sid, 4)) return -1;
+    uint8_t t[32]; size_t m = n - FC_HEAD - FC_TAG; fc_hmac256(w->mac, 32, b, FC_HEAD + m, t); if (!fc_eq(t, b + FC_HEAD + m, FC_TAG)) return -1;
+    memcpy(counter, b + 8, 8); if (m) ctr(w->enc, b, b + FC_HEAD, m, o); return (int)m;
+}
diff --git a/dm/host/friends_crypto.h b/dm/host/friends_crypto.h
new file mode 100644
index 0000000..dc7f0a0
--- /dev/null
+++ b/dm/host/friends_crypto.h
@@ -0,0 +1,26 @@
+// Keys for friends over the internet. Apple's own implementations throughout (Security.framework, CommonCrypto): P-256 identity signatures, P-256 key agreement with fresh keys
+// every session, HKDF-SHA256, AES-256-CTR then HMAC-SHA256.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <Security/Security.h>
+enum { FC_KEY = 65, FC_SIG = 64, FC_CODE = 16, FC_NONCE = 16, FC_TAG = 16, FC_HEAD = 16 };
+SecKeyRef fc_new_key(void);
+int fc_export(SecKeyRef priv, uint8_t out[97]);
+SecKeyRef fc_import(const uint8_t in[97]);
+int fc_public(SecKeyRef priv, uint8_t out[FC_KEY]);
+int fc_sign(SecKeyRef priv, const void *d, size_t n, uint8_t sig[FC_SIG]);
+int fc_verify(const uint8_t pub[FC_KEY], const void *d, size_t n, const uint8_t sig[FC_SIG]);   // 1 when true
+void fc_code(const uint8_t pub[FC_KEY], char out[FC_CODE + 1]);
+int fc_clean_code(const char *typed, char out[FC_CODE + 1]);   // 1 when a code: any case, spaces and dashes ignored, O I L read as 0 1 1
+int fc_eq(const void *a, const void *b, size_t n);
+// The "hi" each side sends at the start of a session: a fresh key, signed by the identity its friend code names
+typedef struct { uint8_t key[FC_KEY], eph[FC_KEY], nonce[FC_NONCE], sig[FC_SIG]; } fc_hi;
+int fc_make_hi(SecKeyRef identity, SecKeyRef eph, const char *to, fc_hi *o);
+int fc_check_hi(const fc_hi *h, const char *from, const char *to);   // 1 when it is really from that code, to this one
+typedef struct { uint8_t enc[32], mac[32]; uint32_t sid; } fc_way;
+typedef struct { fc_way out, in, note_out, note_in; uint8_t link[32]; } fc_keys;
+int fc_session(SecKeyRef my_eph, const fc_hi *mine, const fc_hi *theirs, fc_keys *o);
+void fc_seal(const fc_way *w, uint8_t type, uint64_t counter, const void *d, size_t n, uint8_t *out);   // out: FC_HEAD + n + FC_TAG
+int fc_open(const fc_way *w, const uint8_t *b, size_t n, uint8_t *out, uint64_t *counter);               // the length, or -1
+void fc_hmac256(const void *key, size_t kn, const void *d, size_t n, uint8_t out[32]);
diff --git a/dm/host/friends_internet.h b/dm/host/friends_internet.h
