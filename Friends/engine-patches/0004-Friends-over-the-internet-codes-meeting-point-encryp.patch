+++ b/dm/host/friends_internet.h
@@ -0,0 +1,18 @@
+// Friends over the internet: the player's code, the friends list, the meeting point, and a session with each friend while Local Wireless is open.
+#pragma once
+#include "friends_link.h"
+enum { FI_FRIENDS = 32, FI_REQUESTS = 20, FI_NAME = 100 };
+typedef struct { char code[17], name[FI_NAME]; int on, ready, up, relay, asked; double rtt; } fi_friend;   // asked: they have not added this player yet
+typedef struct { char code[17], name[FI_NAME]; } fi_request;
+typedef struct { int online, open, nfriends, nrequests; char code[17], name[FI_NAME], note[160]; fi_friend friends[FI_FRIENDS]; fi_request requests[FI_REQUESTS]; } fi_view;
+int fi_start(const char *config, const char *folder, int loopback);   // 0: running; -1: not set up (see fi_snapshot's note)
+int fi_running(void);
+void fi_stop(void);
+void fi_snapshot(fi_view *);
+unsigned fi_changes(void);                                            // moves when there is something new to show
+int fi_add(const char *typed, char *why, size_t n);                   // 0, or -1 with the reason in plain words
+void fi_accept(const char *code), fi_decline(const char *code), fi_remove(const char *code);
+int fi_rename(const char *name);
+void fi_open(friends_link *);                                         // Local Wireless opened
+void fi_close(void);                                                  // and closed: call before fl_stop
+int fi_send(void *, int slot, const void *, size_t);
diff --git a/dm/host/friends_internet.m b/dm/host/friends_internet.m
new file mode 100644
index 0000000..243aab2
--- /dev/null
+++ b/dm/host/friends_internet.m
@@ -0,0 +1,208 @@
+#import <Foundation/Foundation.h>
+#include "friends_internet.h"
+#include "friends_path.h"
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+void dm_friends_log(const char *what);   // hle_friends_link.c: the game's log (never names, codes or addresses)
+@interface DFFriend : NSObject { @public NSString *code, *name; BOOL asked, on, ready, paired, sentCands; int slot; SecKeyRef eph; fc_hi hi, theirs; fc_keys keys; uint64_t noteOut, noteIn, began, pairedAt, hiAt, tokensAt, namedAt; double tokens; NSData *late, *key; uint64_t lateAt; } @end
+@implementation DFFriend
+- (instancetype)init { if ((self = [super init])) { slot = -1; tokens = 4; } return self; }
+- (void)wipe { if (eph) CFRelease(eph); eph = NULL; paired = NO; memset_s(&hi, sizeof hi, 0, sizeof hi); memset_s(&theirs, sizeof theirs, 0, sizeof theirs); memset_s(&keys, sizeof keys, 0, sizeof keys); noteOut = noteIn = 0; late = nil; }
+- (void)dealloc { [self wipe]; }
+@end
+
+static dispatch_queue_t Q; static char QK; static _Atomic unsigned g_changes; static _Atomic int g_running;
+static NSURL *g_url; static NSString *g_host, *g_folder, *g_name = @"", *g_note = @""; static uint8_t g_circle[32]; static SecKeyRef g_id; static uint8_t g_pub[65]; static char g_code[17];
+static NSMutableArray<DFFriend *> *g_friends; static NSMutableArray<NSDictionary *> *g_requests; static NSMutableOrderedSet<NSString *> *g_blocked; static int g_loop;
+static NSURLSession *g_session; static NSURLSessionWebSocketTask *g_ws; static BOOL g_in, g_relay_there, g_turn_asked; static int g_tries; static uint64_t g_turn_at, g_heard; static dispatch_source_t g_tick;
+static friends_link *g_link; static friends_path *g_path; static pthread_rwlock_t g_path_l = PTHREAD_RWLOCK_INITIALIZER;
+static uint64_t ms(void) { return clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1000000; }
+static void changed(void) { atomic_fetch_add(&g_changes, 1); }
+static void on_q(dispatch_block_t b) { if (dispatch_get_specific(&QK)) b(); else dispatch_sync(Q, b); }
+static NSString *b64(const void *d, size_t n) { return [[NSData dataWithBytes:d length:n] base64EncodedStringWithOptions:0]; }
+static NSData *un64(id s, size_t want) { if (![s isKindOfClass:NSString.class]) return nil; NSData *d = [[NSData alloc] initWithBase64EncodedString:s options:0]; return d && (!want || d.length == want) ? d : nil; }
