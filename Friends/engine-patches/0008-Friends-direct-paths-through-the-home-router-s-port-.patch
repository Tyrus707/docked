     if (!dm_friends_on()) return t_skerr;
-    switch (t_skerr) { case 35: return 11; case 36: return 115; case 39: return 89; case 40: return 90; case 42: return 92; case 45: return 95; case 48: return 98; case 49: return 99; case 50: return 100; case 55: return 105; case 57: return 107; default: return t_skerr; }
+    switch (t_skerr) { case 35: return 11; case 36: return 115; case 39: return 89; case 40: return 90; case 42: return 92; case 45: return 95; case 48: return 98; case 49: return 99; case 50: return 100; case 55: return 105; case 57: return 107; case 37: return 114; case 51: return 101; case 54: return 104; case 56: return 106; case 60: return 110; case 61: return 111; case 65: return 113; default: return t_skerr; }
 }
 #define SKF(m, cname, ...) HLE_FORCE(m, "local BSD descriptor service; remote networking unavailable", int, cname, __VA_ARGS__)
 void dm_guest_sleep_ns(int64_t ns);
